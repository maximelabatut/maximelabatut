# Copier ce fichier en .env puis renseigner les valeurs. Le vrai .env n'est jamais versionné.

# Un token par tunnel Cloudflare, un tunnel par application.
# Zero Trust > Networks > Tunnels > <tunnel> : le token est dans la commande d'installation Docker (eyJ...).
CLOUDFLARE_TUNNEL_TOKEN_WWW=
CLOUDFLARE_TUNNEL_TOKEN_GAMEVAULT=
CLOUDFLARE_TUNNEL_TOKEN_WEB2=
CLOUDFLARE_TUNNEL_TOKEN_CONFIG=
CLOUDFLARE_TUNNEL_TOKEN_LOGS=
CLOUDFLARE_TUNNEL_TOKEN_NETDATA=
CLOUDFLARE_TUNNEL_TOKEN_UPTIME=

# Identifiant du groupe docker de la machine (lu par Netdata) : getent group docker | cut -d: -f3
DOCKER_GID=
